{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usuyo",
  "version": "0.0.0",
  "identifier": "dev.usuyo.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "sh src-tauri/stage-core.sh debug && pnpm --dir web dev",
    "beforeBuildCommand": "sh src-tauri/stage-core.sh release && pnpm --dir web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "usuyo",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http://127.0.0.1:47615",
        "media-src": "'self' http://127.0.0.1:47615",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:47615",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http://127.0.0.1:47615",
        "media-src": "'self' http://127.0.0.1:47615",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/usuyo"
    ],
    "resources": {
      "core-plugins/": "plugins/"
    }
  }
}
