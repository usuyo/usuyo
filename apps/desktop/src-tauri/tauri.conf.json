{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usuyo",
  "version": "0.0.0",
  "identifier": "dev.usuyo.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "pnpm --dir web dev",
    "beforeBuildCommand": "pnpm --dir web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "usuyo",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
