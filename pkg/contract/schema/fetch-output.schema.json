{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "usuyo adapter fetch output",
  "description": "JSON an adapter prints on stdout for `fetch <url> --out <dir>`. File paths are relative to <dir>. Normative source: docs/SPEC.md §8. Arrays are always present and may be empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "kind",
    "title",
    "text",
    "images",
    "media",
    "platformTags",
    "completeness",
    "missing",
    "evidence"
  ],
  "properties": {
    "identity": { "$ref": "#/$defs/identity" },
    "kind": { "$ref": "#/$defs/kind" },
    "title": { "type": "string" },
    "author": { "$ref": "#/$defs/author" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "text": { "type": "string" },
    "html": { "type": "string", "description": "Path of the raw HTML snapshot." },
    "images": { "type": "array", "items": { "type": "string" } },
    "media": { "type": "array", "items": { "type": "string" } },
    "platformTags": { "type": "array", "items": { "type": "string" } },
    "completeness": { "$ref": "#/$defs/completeness" },
    "missing": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fetchedAt"],
      "properties": {
        "fetchedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "integer", "description": "HTTP status code when the method has one." }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "contentId": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "platformId": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "kind": { "enum": ["article", "post", "image", "video", "file"] },
    "completeness": { "enum": ["link", "partial", "full"] }
  }
}
