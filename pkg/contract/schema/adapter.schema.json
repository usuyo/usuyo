{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xiecun adapter.yaml",
  "description": "Declaration file of an adapter, written in YAML; convert to JSON before validating. Normative source: docs/SPEC.md §8.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "platforms", "match", "capabilities", "method", "requires", "cost", "outputs"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
      "description": "<namespace>/<name>, e.g. community/wechat-mp-basic."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "match": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "URL glob patterns this adapter handles."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["fetch", "list", "watch"] }
    },
    "method": { "enum": ["cli", "local-service", "mcp", "http-api", "browser"] },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "license"],
      "properties": {
        "project": { "type": "string" },
        "license": { "type": "string" },
        "install": { "type": "object", "description": "Free-form until SPEC §8 fixes its shape." }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cookie", "proxy"],
      "properties": {
        "cookie": { "type": "string" },
        "proxy": { "type": "string" }
      }
    },
    "cost": { "type": "string" },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "limits": { "type": "string" }
  }
}
