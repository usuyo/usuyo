{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FetchOutput",
  "description": "fetch 的输出（协议 §3.7）。路径都相对 `--out`；数组总是出现。",
  "type": "object",
  "properties": {
    "author": {
      "anyOf": [
        {
          "$ref": "#/$defs/Author"
        },
        {
          "type": "null"
        }
      ]
    },
    "comments": {
      "description": "固定是 `comments.json`（协议 §13 第 31 项）。",
      "anyOf": [
        {
          "$ref": "#/$defs/RelPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "credentialsUpdate": {
      "description": "调用期间平台换了会话 cookie 时交回（§6，`storageState` 的形状；凭据还没接，原样带着）。"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "html": {
      "description": "原始 HTML 文件。",
      "anyOf": [
        {
          "$ref": "#/$defs/RelPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "description": "省略等于 `{\"platform\": \"file\"}`。",
      "anyOf": [
        {
          "$ref": "#/$defs/Identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RelPath"
      }
    },
    "kind": {
      "$ref": "#/$defs/ItemKind"
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Media"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputKind"
      }
    },
    "missingReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "const": true
    },
    "platformTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publishedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rfc3339"
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "description": "平台原文的文字。",
      "type": [
        "string",
        "null"
      ]
    },
    "textFormat": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextFormat"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "ok",
    "kind",
    "images",
    "media",
    "platformTags",
    "completeness",
    "missing",
    "evidence"
  ],
  "$defs": {
    "Access": {
      "description": "七层取法，从低到高（协议 §2.4）。只是给用户挑选用的标签，宿主不据此拦截。",
      "type": "string",
      "enum": [
        "official-export",
        "public-web",
        "vision-ui",
        "browser-session",
        "session-api",
        "private-api",
        "client-hook"
      ]
    },
    "Author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "platformId": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "link",
        "partial",
        "full"
      ]
    },
    "Evidence": {
      "description": "这次调用实际怎么拿到的。",
      "type": "object",
      "properties": {
        "access": {
          "description": "这次实际用到的那一层。",
          "$ref": "#/$defs/Access"
        },
        "fetchedAt": {
          "$ref": "#/$defs/Rfc3339"
        },
        "site": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "只在 HTTP 类请求时填。",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "upstream": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpstreamVersion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fetchedAt",
        "access"
      ]
    },
    "Identity": {
      "description": "线上的形状：`{platform, contentId?, url?}`。",
      "type": "object",
      "properties": {
        "contentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "$ref": "#/$defs/PlatformId"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "platform"
      ]
    },
    "ItemKind": {
      "description": "条目种类（沿用 v0 的词表）。",
      "type": "string",
      "enum": [
        "article",
        "post",
        "image",
        "video",
        "file"
      ]
    },
    "Media": {
      "type": "object",
      "properties": {
        "durationSec": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "group": {
          "description": "同一个值表示同一段时间线拆开的几个文件，例如分开存的画面和音轨（协议 §13 第 38 项）。",
          "anyOf": [
            {
              "$ref": "#/$defs/MediaGroup"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "kind"
      ]
    },
    "MediaGroup": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "MediaKind": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "subtitle",
        "other"
      ]
    },
    "OutputKind": {
      "description": "`outputs` 的固定词表（协议 §2.3；`comments` 照 §13 第 31 项）。",
      "type": "string",
      "enum": [
        "text",
        "html",
        "images",
        "media:video",
        "media:audio",
        "subtitle",
        "meta",
        "comments"
      ]
    },
    "PlatformId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "RelPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)[^\\\\]+$"
    },
    "Rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "TextFormat": {
      "type": "string",
      "enum": [
        "plain",
        "markdown"
      ]
    },
    "UpstreamVersion": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    }
  }
}
