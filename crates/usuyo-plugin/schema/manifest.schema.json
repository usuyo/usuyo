{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginManifest",
  "description": "清单的线上形状，也是 `manifest.schema.json` 的来源。种类专属的字段都可选，语义检查再判。",
  "type": "object",
  "properties": {
    "consumes": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/WireConsume"
      }
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "homepage": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "id": {
      "$ref": "#/$defs/PluginId"
    },
    "install": {
      "anyOf": [
        {
          "$ref": "#/$defs/Install"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/PluginKindTag"
    },
    "license": {
      "type": "string"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "match": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "methods": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/WireMethod"
      }
    },
    "models": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/ModelSpec"
      }
    },
    "name": {
      "type": "string"
    },
    "pacing": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "default": null,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": {
          "$ref": "#/$defs/Pacing"
        }
      }
    },
    "permissions": {
      "$ref": "#/$defs/WirePermissions"
    },
    "platforms": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/PlatformId"
      }
    },
    "produces": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/Produce"
      }
    },
    "protocol": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderNeed"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "readback": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    },
    "requires": {
      "$ref": "#/$defs/WireRequires",
      "default": {
        "runtime": []
      }
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "settings": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Setting"
      }
    },
    "sites": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/Site"
      }
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "upstream": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Upstream"
      }
    },
    "version": {
      "type": "string"
    },
    "visitors": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/Visitor"
      }
    },
    "writes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExportWrites"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "protocol",
    "id",
    "kind",
    "name",
    "version",
    "license",
    "maintainers",
    "permissions",
    "run"
  ],
  "$defs": {
    "Access": {
      "description": "七层取法，从低到高（协议 §2.4）。只是给用户挑选用的标签，宿主不据此拦截。",
      "type": "string",
      "enum": [
        "official-export",
        "public-web",
        "vision-ui",
        "browser-session",
        "session-api",
        "private-api",
        "client-hook"
      ]
    },
    "Account": {
      "description": "账号在哪里被用到（§2.3.1）。顺序就是同一层里挑方法的先后：先不带账号的。",
      "oneOf": [
        {
          "description": "不用账号。",
          "type": "string",
          "const": "none"
        },
        {
          "description": "访客身份（§2.5.1），不是账号。",
          "type": "string",
          "const": "visitor"
        },
        {
          "description": "只在你自己的浏览器里。",
          "type": "string",
          "const": "own-browser"
        },
        {
          "description": "只在你手机的 App 里。",
          "type": "string",
          "const": "own-phone"
        },
        {
          "description": "只在你电脑的客户端里。",
          "type": "string",
          "const": "own-app"
        },
        {
          "description": "登录进 usuyo。",
          "type": "string",
          "const": "in-usuyo"
        },
        {
          "description": "你申请的开发者凭据。",
          "type": "string",
          "const": "developer"
        }
      ]
    },
    "Asset": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ]
    },
    "ByteSize": {
      "type": "string",
      "pattern": "^[0-9]+(B|KiB|MiB|GiB|TiB)$"
    },
    "ConsumeKind": {
      "description": "转换插件吃的东西（协议 §2.9）。",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "media:video",
            "media:audio",
            "image",
            "html",
            "text",
            "subtitle",
            "derived:asr",
            "derived:ocr",
            "derived:vision",
            "derived:keyframes"
          ]
        },
        {
          "description": "16 kHz 单声道 WAV，抽音轨插件的中间产物（`produces: audio:pcm16k`），不进资料库。",
          "type": "string",
          "const": "audio:pcm16k"
        }
      ]
    },
    "Credential": {
      "type": "string",
      "enum": [
        "cookies",
        "browser-profile",
        "app"
      ]
    },
    "Delivers": {
      "description": "不在插件进程里跑的方法交什么给本机接口（§5）。",
      "type": "string",
      "enum": [
        "links"
      ]
    },
    "Device": {
      "type": "string",
      "enum": [
        "adb",
        "ios-device",
        "screen-capture",
        "accessibility",
        "audio-capture",
        "clipboard"
      ]
    },
    "Duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$"
    },
    "ExportWrites": {
      "type": "string",
      "enum": [
        "files",
        "api"
      ]
    },
    "FetchInputKind": {
      "type": "string",
      "enum": [
        "url",
        "ref"
      ]
    },
    "FsPermissions": {
      "type": "object",
      "properties": {
        "read": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Inject": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "host": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "header",
        "format"
      ]
    },
    "Install": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Asset"
          }
        }
      },
      "required": [
        "assets"
      ]
    },
    "Interaction": {
      "type": "string",
      "enum": [
        "background",
        "foreground"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteSize"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout": {
          "description": "转换、导出插件单次 `run` 的总时长；获取插件用能力里的 `timeout`。",
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "ListAction": {
      "description": "平台上的动作。",
      "type": "string",
      "enum": [
        "favorite",
        "like",
        "share",
        "view",
        "unknown"
      ]
    },
    "ListOrder": {
      "type": "string",
      "enum": [
        "newest-first",
        "unordered"
      ]
    },
    "Login": {
      "type": "string",
      "enum": [
        "none",
        "optional",
        "required"
      ]
    },
    "ModelFormat": {
      "description": "下载下来的是什么：单个文件，或宿主解到 `${MODELS}/<name>/` 的压缩包。",
      "type": "string",
      "enum": [
        "file",
        "tar.bz2",
        "tar.gz",
        "zip"
      ]
    },
    "ModelSpec": {
      "description": "要宿主下载的模型（协议 §2.9）。宿主下，插件不联网；放进 `${MODELS}/<name>/`。",
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/ModelFormat"
        },
        "license": {
          "description": "模型权重的许可，下载前给你看。",
          "type": "string"
        },
        "mirrors": {
          "description": "同一个 sha256 的别的地址，`url` 不行时按顺序试。",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "description": "目录名：小写字母、数字、`.`、`_`、`-`，不以 `.` 开头，一个清单里不重名。",
          "type": "string"
        },
        "setting": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sha256": {
          "description": "整个下载文件的 sha256。",
          "type": "string"
        },
        "size": {
          "description": "整个下载文件的字节数，下载前给你看。",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "url",
        "sha256",
        "size",
        "format",
        "license"
      ]
    },
    "NetworkMode": {
      "type": "string",
      "enum": [
        "none",
        "allowlist"
      ]
    },
    "NetworkPermissions": {
      "type": "object",
      "properties": {
        "hosts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/NetworkMode",
          "default": "none"
        }
      }
    },
    "OutputKind": {
      "description": "`outputs` 的固定词表（协议 §2.3；`comments` 照 §13 第 31 项）。",
      "type": "string",
      "enum": [
        "text",
        "html",
        "images",
        "media:video",
        "media:audio",
        "subtitle",
        "meta",
        "comments"
      ]
    },
    "Pacing": {
      "type": "object",
      "properties": {
        "batch": {
          "description": "`false` 表示只接受用户一条条收下。",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "daily": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "PlatformId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "PluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9_-][a-z0-9._-]{0,99}$"
    },
    "PluginKindTag": {
      "type": "string",
      "enum": [
        "fetch",
        "transform",
        "export"
      ]
    },
    "Produce": {
      "description": "转换插件产出的东西（协议 §2.9）：产物种类，不是路径。路径由宿主定在 `derived/runs/<runId>/` 下。\n同一个词表也是 `run` 的 `want` 和结果里每个输出的 `kind`（协议 §4.2）。",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "asr",
            "keyframes",
            "ocr",
            "readable",
            "vision",
            "summary",
            "embeddings"
          ]
        },
        {
          "description": "分开的画面和音轨合起来能播的文件。",
          "type": "string",
          "const": "play"
        },
        {
          "description": "给转写用的 16 kHz 单声道 WAV；中间产物，不进资料库。",
          "type": "string",
          "const": "audio:pcm16k"
        },
        {
          "description": "只回流的信息（结果里的 `probe`），不出文件。",
          "type": "string",
          "const": "probe"
        }
      ]
    },
    "ProviderNeed": {
      "type": "string",
      "enum": [
        "none",
        "optional",
        "required"
      ]
    },
    "Risk": {
      "description": "记录到的一句情况。只是信息，宿主不拿它拦。",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/RiskSource"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "source"
      ]
    },
    "RiskSource": {
      "description": "记录到的一句情况的出处。",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ]
    },
    "Run": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serve": {
          "description": "支不支持常驻模式（§3.12，宿主还没用它）。",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "command"
      ]
    },
    "Setting": {
      "description": "插件设置（协议 §2.11）。",
      "type": "object",
      "properties": {
        "default": {
          "default": null
        },
        "inject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "secret": {
          "type": "boolean",
          "default": false
        },
        "type": {
          "$ref": "#/$defs/SettingType"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ]
    },
    "SettingType": {
      "type": "string",
      "enum": [
        "string",
        "bool",
        "int",
        "enum"
      ]
    },
    "Site": {
      "description": "会用到哪个站点的账号（协议 §2.5）。",
      "type": "object",
      "properties": {
        "cookies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "credential": {
          "$ref": "#/$defs/Credential"
        },
        "domains": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "loginUrl": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "site": {
          "type": "string"
        }
      },
      "required": [
        "site",
        "name",
        "credential"
      ]
    },
    "SourceInfo": {
      "description": "一个用户能选的列表来源（`sources` 的输出，也用在清单的 `list.sources`）。",
      "type": "object",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ListAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "description": "插件自己定，建议 `<platform>:<kind>[:<id>]`；`file:` 开头的留给导入。",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "title"
      ]
    },
    "Upstream": {
      "type": "object",
      "properties": {
        "license": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "paid": {
          "type": "boolean",
          "default": false
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "license"
      ]
    },
    "Visitor": {
      "description": "访客身份（协议 §2.5.1）：站点给任何没登录的访客的 cookie，不是账号。\n和同一主机的账号分开存、分开交。",
      "type": "object",
      "properties": {
        "cookies": {
          "description": "这些名字都有了才算取到；空的时候等名字不再变。",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "url": {
          "description": "打开哪一页来取，只能是 https。",
          "type": "string"
        }
      },
      "required": [
        "site",
        "name",
        "url"
      ]
    },
    "WireCapabilities": {
      "type": "object",
      "properties": {
        "fetch": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireCapability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "list": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireCapability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unfavorite": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireCapability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "WireCapability": {
      "description": "能力声明的线上形状：三种能力共用一个结构，哪些字段属于哪种能力在语义检查里判。\n`access`、`login`、`sites`、`visitors`、`interaction`、`perPlatform` 挪到了方法上（§2.3.1）：\n还写在能力里的清单照旧形状拒掉，说清楚挪到了哪里。",
      "type": "object",
      "properties": {
        "files": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "input": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/FetchInputKind"
          }
        },
        "link": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "order": {
          "anyOf": [
            {
              "$ref": "#/$defs/ListOrder"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/OutputKind"
          }
        },
        "provider": {
          "$ref": "#/$defs/ProviderNeed",
          "default": "none"
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/SourceInfo"
          }
        },
