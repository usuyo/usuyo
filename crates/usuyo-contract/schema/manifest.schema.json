{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usuyo:schema:manifest:1",
  "title": "usuyo manifest.json v1",
  "description": "Index card of one item folder. Normative source: docs/SPEC.md §1.2.1. Arrays are always present and may be empty. Unknown fields are tolerated at runtime (§0.2).",
  "type": "object",
  "required": [
    "id",
    "aliases",
    "identities",
    "kind",
    "title",
    "addedAt",
    "origins",
    "snapshots",
    "primarySnapshot",
    "outputs",
    "missing",
    "completeness",
    "tags",
    "topics",
    "sameAs",
    "notSameAs",
    "private",
    "state"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/itemId" },
    "aliases": { "type": "array", "items": { "$ref": "#/$defs/itemId" } },
    "identities": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
    "kind": { "type": "string", "examples": ["article", "post", "image", "video", "file", "unknown"] },
    "title": { "type": "string" },
    "author": { "$ref": "#/$defs/author" },
    "publishedAt": { "$ref": "#/$defs/time" },
    "publishedAtOriginal": { "type": "string", "format": "date-time" },
    "lang": { "type": "string" },
    "addedAt": { "$ref": "#/$defs/time" },
    "origins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/origin" } },
    "snapshots": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } },
    "primarySnapshot": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid7" }] },
    "outputs": { "$ref": "#/$defs/outputs" },
    "missing": { "$ref": "#/$defs/outputs" },
    "missingReason": { "type": "string" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "tags": {
      "type": "object",
      "required": ["platform", "engine", "user", "dismissed"],
      "properties": {
        "platform": { "type": "array", "items": { "$ref": "#/$defs/tagMark" } },
        "engine": { "type": "array", "items": { "$ref": "#/$defs/tagMark" } },
        "user": { "type": "array", "items": { "type": "string" } },
        "dismissed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "topics": { "type": "array", "items": { "$ref": "#/$defs/uuid7" } },
    "sameAs": { "type": "array", "items": { "$ref": "#/$defs/itemId" } },
    "notSameAs": { "type": "array", "items": { "$ref": "#/$defs/itemId" } },
    "private": { "type": "boolean" },
    "state": { "enum": ["normal", "text-only", "trashed"] },
    "stateAt": { "$ref": "#/$defs/time" },
    "textOnly": {
      "type": "object",
      "required": ["at", "removed"],
      "properties": {
        "at": { "$ref": "#/$defs/time" },
        "removed": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "itemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-[a-z2-7]{26}$" },
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "examples": ["text", "html", "images", "media:video", "media:audio", "subtitle", "meta", "comments"]
      }
    },
    "completeness": { "enum": ["link", "partial", "full"] },
    "identity": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "contentId": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "platformId": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "origin": {
      "type": "object",
      "required": ["id", "entry", "takenBy", "at", "device"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid7" },
        "entry": {
          "type": "string",
          "examples": ["paste", "drop", "extension", "mobile", "import", "subscription", "mcp", "cli", "api"]
        },
        "takenBy": { "type": "string", "pattern": "^(user|agent:[a-z0-9-]+|subscription:.+)$" },
        "machinePicked": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["by"],
              "properties": {
                "by": { "type": "string", "examples": ["keywords", "similarity", "upstream", "agent"] },
                "name": { "type": "string" }
              }
            }
          ]
        },
        "matched": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "by"],
            "properties": {
              "topic": { "$ref": "#/$defs/uuid7" },
              "by": { "type": "string", "examples": ["keywords", "similarity"] }
            }
          }
        },
        "subscription": { "type": "string" },
        "importBatch": { "type": "string" },
        "action": { "type": "string" },
        "actedAt": { "$ref": "#/$defs/time" },
        "actedAtOriginal": { "type": "string", "format": "date-time" },
        "at": { "$ref": "#/$defs/time" },
        "device": { "$ref": "#/$defs/uuid7" }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["id", "plugin", "at", "access", "outputs", "missing", "completeness"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid7" },
        "plugin": { "type": "string" },
        "pluginVersion": { "type": "string" },
        "at": { "$ref": "#/$defs/time" },
        "inputUrl": { "type": "string" },
        "resolvedUrl": { "type": "string" },
        "access": { "type": "string" },
        "site": { "type": "string" },
        "upstream": { "type": "object" },
        "outputs": { "$ref": "#/$defs/outputs" },
        "missing": { "$ref": "#/$defs/outputs" },
        "missingReason": { "type": "string" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "textOrigin": { "type": "string", "examples": ["platform", "machine"] }
      }
    },
    "tagMark": {
      "type": "object",
      "required": ["tag", "by", "at", "confidence"],
      "properties": {
        "tag": { "type": "string" },
        "by": { "type": "string" },
        "at": { "$ref": "#/$defs/time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
