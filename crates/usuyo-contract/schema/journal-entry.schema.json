{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usuyo:schema:journal-entry:1",
  "title": "usuyo journal entry v1",
  "description": "One line of .usuyo/journal/<deviceId>/<segment>.jsonl. Normative source: docs/SPEC.md §1.6. After a purge, targets[].id, targets[].path and change are {\"redacted\": true}.",
  "type": "object",
  "required": ["id", "n", "t", "device", "actor", "op", "targets", "batch"],
  "properties": {
    "id": { "$ref": "#/$defs/uuid7" },
    "n": { "type": "integer", "minimum": 1 },
    "t": { "$ref": "#/$defs/time" },
    "device": { "$ref": "#/$defs/uuid7" },
    "actor": {
      "type": "string",
      "pattern": "^(user|external|sync|host|agent:[a-z0-9-]+|model:.+|plugin:.+|subscription:[0-9a-f-]{36})$"
    },
    "via": {
      "type": "string",
      "pattern": "^(app|cli|mcp|api|extension|mobile|import|subscription|file|readback:.+)$"
    },
    "op": {
      "type": "string",
      "examples": ["add-item", "set-tags", "edit-notes", "move-to-trash", "restore", "purge"]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "path", "before", "after"],
        "properties": {
          "kind": { "type": "string" },
          "id": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/redacted" }] },
          "path": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/redacted" }] },
          "before": { "$ref": "#/$defs/hashOrNull" },
          "after": { "$ref": "#/$defs/hashOrNull" }
        }
      }
    },
    "change": { "type": "object" },
    "changeSet": { "$ref": "#/$defs/uuid7" },
    "changeOp": { "$ref": "#/$defs/uuid7" },
    "batch": { "$ref": "#/$defs/uuid7" },
    "undoes": { "$ref": "#/$defs/uuid7" }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "hashOrNull": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }]
    },
    "redacted": {
      "type": "object",
      "required": ["redacted"],
      "properties": { "redacted": { "const": true } }
    }
  }
}
