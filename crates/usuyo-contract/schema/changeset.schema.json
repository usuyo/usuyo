{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usuyo:schema:changeset:1",
  "title": "usuyo changeset v1",
  "description": "A proposal file .usuyo/changes/<id>.json. Normative source: docs/SPEC.md §1.5.2. Each op is {id, op, target, base, args, state}; ops that edit paragraphs carry hunks inside args.",
  "type": "object",
  "required": ["id", "createdAt", "proposer", "state", "ops"],
  "properties": {
    "id": { "$ref": "#/$defs/uuid7" },
    "createdAt": { "$ref": "#/$defs/time" },
    "proposer": { "type": "string", "pattern": "^(agent|model):" },
    "model": { "type": "string" },
    "via": { "type": "string" },
    "summary": { "type": "string" },
    "state": { "enum": ["proposed", "accepted", "partly-accepted", "rejected"] },
    "decidedAt": { "$ref": "#/$defs/time" },
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "op", "target", "base", "state"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid7" },
          "op": { "type": "string", "examples": ["set-tags", "set-topics", "edit-notes", "create-card", "add-citation"] },
          "target": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string", "examples": ["item", "topic", "card", "draft"] },
              "id": { "type": "string" }
            }
          },
          "base": {
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }]
          },
          "args": { "type": "object" },
          "state": { "enum": ["proposed", "accepted", "rejected", "conflict"] },
          "edited": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
