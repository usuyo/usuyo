{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usuyo:schema:keyframes:1",
  "title": "usuyo keyframes.json v1",
  "description": "Keyframes picked in one keyframes run, derived/runs/<runId>/keyframes.json. Written by the transform plugin, read by the host. Normative source: docs/SPEC.md §1.2.2. Times are seconds with at most 3 decimals; frame paths are relative to the run folder.",
  "type": "object",
  "required": ["snapshot", "durationSec", "frames", "frozenSec"],
  "properties": {
    "snapshot": { "$ref": "#/$defs/uuid7" },
    "durationSec": { "$ref": "#/$defs/seconds" },
    "frozenSec": { "$ref": "#/$defs/seconds" },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sec", "path", "sha256", "width", "height", "scene"],
        "properties": {
          "sec": { "$ref": "#/$defs/seconds" },
          "path": { "type": "string", "pattern": "^keyframes/[0-9]{8}\\.jpg$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "scene": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] }
        }
      }
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "seconds": { "type": "number", "minimum": 0 }
  }
}
