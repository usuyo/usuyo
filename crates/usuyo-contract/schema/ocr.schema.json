{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usuyo:schema:ocr:1",
  "title": "usuyo ocr.json v1",
  "description": "Text read from images in one ocr or frames run, derived/runs/<runId>/ocr.json. Written by the transform plugin, read by the host. Normative source: docs/SPEC.md §1.2.2. bbox is [x, y, w, h] in 0-1 of the image size, origin top left. input is an index into run.json inputs.",
  "type": "object",
  "required": ["images"],
  "properties": {
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input", "width", "height", "lines"],
        "properties": {
          "input": { "type": "integer", "minimum": 0 },
          "imageKey": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "frameSec": { "type": "number", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "bbox", "confidence"],
              "properties": {
                "text": { "type": "string" },
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "oneOf": [
          { "required": ["imageKey"], "not": { "required": ["frameSec"] } },
          { "required": ["frameSec"], "not": { "required": ["imageKey"] } }
        ]
      }
    }
  }
}
