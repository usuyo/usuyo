{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usuyo:schema:notes:1",
  "title": "usuyo notes.md front matter v1",
  "description": "Parsed front matter object (docs/SPEC.md §1.4). The on-disk form is the fixed YAML subset of §0.6; false and empty lists are omitted there.",
  "type": "object",
  "required": [],
  "properties": {
    "takeaway": {
      "type": "string"
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
